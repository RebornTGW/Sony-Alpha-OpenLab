# ==========================================================================
# Sony-Alpha-OpenLab — .gitignore STRICT
# Ce dépôt ne doit JAMAIS contenir de fichiers extraits du firmware Sony.
# Les binaires propriétaires (firmware, bibliothèques, images) sont exclus.
# ==========================================================================

# --- Binaires / firmware propriétaires (interdits dans ce dépôt) ---
*.DAT
*.dat
*.so
*.so.*
*.bin
*.elf
*.ko
*.img
*.tar
*.unpacked
*.str.txt

# --- Dumps / extractions éventuelles ---
extracted*/
firmware*/
dumps/
*.dump
*.hex

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- Environnements virtuels & secrets ---
.env
.env.*
venv/
.venv/
env/

# --- OS / éditeurs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local capture output
out/
*.arw
*.ARW

# --- Payloads dérivés du firmware (fournis localement depuis le kit GPL) ---
# Les profils Open Gate référencent payloads/*.bin ; ces octets ne doivent
# JAMAIS entrer dans ce dépôt MIT. Gardés hors-dépôt, vérifiés par sha256.
payloads/

# --- Dumps bruts de test matériel (JAMAIS publiés : contiennent des octets firmware) ---
camera_private/
*_a6700_dump/
*_a6700_check/
readcheck_result.txt
transcript.jsonl

# --- Build natif (Rust / Zig / C) ---
target/
zig-out/
.zig-cache/
zig-cache/
target-helper/build/
